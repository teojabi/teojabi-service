# Backend (NestJS) Environment Variables Example
# 이 파일은 개발자가 참고하기 위한 템플릿입니다. 실제 기능 동작에는 .env 복사본을 만들어 값을 채워주세요.

# ==========================================
# 1. NestJS 서버 기본 설정
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# 2. Database (Supabase PostgreSQL / Prisma 연동)
# ==========================================

# Prisma가 사용할 기본 DB 연결 URL 
# Supabase 환경에 맞는 Connection Pooler (Transaction 모드 권장) URI를 사용합니다.
DATABASE_URL="postgresql://postgres.[프로젝트ID]:[비밀번호]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 마이그레이션 등을 위해 직접 접속하는 Session URL
DIRECT_URL="postgresql://postgres.[프로젝트ID]:[비밀번호]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# ==========================================
# 3. Third-party APIs & Public Data (브라우저 노출 X)
# ==========================================

# 공공데이터포털 - 공시지가, 실거래가 API 디코딩/인코딩 인증키
PUBLIC_DATA_API_KEY=your_public_data_portal_api_key_here

# 국토정보플랫폼 토지이음 API 인증키
TOJIEUM_API_KEY=your_tojieum_api_key_here

# ==========================================
# 4. Security & JWT (필요시)
# ==========================================
# 프론트엔드 통신 간 CORS 허용 오리진 리스트
CORS_ORIGIN=http://localhost:3001,https://teojabi.com

# JWT 생성 비밀키 (NextAuth를 주로 사용하더라도, 별도로 백엔드 JWT 발급이 필요할 경우)
JWT_SECRET=your_backend_jwt_secret_here
