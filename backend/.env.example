# Database Configuration (Supabase Local Default)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Server Configuration
PORT=3001
FRONTEND_URL="http://localhost:3000"

# JWT Authentication
# 개발 환경용 임의의 문자열. 운영 환경에서는 길고 복잡한 난수 문자열을 사용하세요.
JWT_SECRET="dev-secret-key-1234!"

# Naver Social Login
# 네이버 개발자 센터 (https://developers.naver.com/) 에서 앱 등록 후 발급받은 키 입력
NAVER_CLIENT_ID="your_naver_client_id_here"
NAVER_CLIENT_SECRET="your_naver_client_secret_here"
NAVER_CALLBACK_URL="http://localhost:3001/api/v1/auth/naver/callback"

# Kakao Social Login
# 카카오 디벨로퍼스 (https://developers.kakao.com/) 에서 앱 등록 후 발급받은 REST API 키 및 시크릿 입력
KAKAO_CLIENT_ID="your_kakao_rest_api_key_here"
KAKAO_CLIENT_SECRET="your_kakao_client_secret_here"
KAKAO_CALLBACK_URL="http://localhost:3001/api/v1/auth/kakao/callback"

# Google Social Login
# Google Cloud Console (https://console.cloud.google.com/) 에서 앱 등록 후 발급받은 클라이언트 ID 및 시크릿 입력
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"
