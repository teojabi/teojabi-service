# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# DB 연결 및 호스팅
# Supabase 대시보드 -> Settings -> Database -> Connection string 에서 확인 가능
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres"

# Server Configuration
PORT=3001
FRONTEND_URL="http://localhost:3000"
BACKEND_PUBLIC_URL="http://localhost:3001"

# Email Verification (NCP Cloud Outbound Mailer)
# Cloud Outbound Mailer API 호출용 인증키 및 발신자 정보를 사용하세요.
NCLOUD_MAIL_BASE_URL="https://mail.apigw.ntruss.com"
NCLOUD_ACCESS_KEY="YOUR_NCP_ACCESS_KEY"
NCLOUD_SECRET_KEY="YOUR_NCP_SECRET_KEY"
NCLOUD_MAIL_SENDER_ADDRESS="no-reply@your-domain.com"
NCLOUD_MAIL_SENDER_NAME="터잡이"

# JWT Authentication
# 개발 환경용 임의의 문자열. 운영 환경에서는 길고 복잡한 난수 문자열을 사용하세요.
JWT_SECRET="YOUR_JWT_SECRET_KEY_HERE"

# PortOne Subscription Billing
# 포트원 콘솔에서 발급받은 Store ID / Channel Key / API Secret / Webhook Secret
# Store ID : 테스트 후 PG사에서 제공해주는 ID인 MID와 혼동 하지 말자. Store ID는 테스트와 실운영이 동일 하다.
# Channel Key : 테스트와 실연동 채널은 별개로 따로 추가 해야 한다.
# API Secret : 테스트와 실연동이 동일
# Webhook Secret : 테스트와 실연동 채널 별개로 따로 추가 해야 한다.
PORTONE_STORE_ID="store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# 정기결제 전용 채널 키
PORTONE_CHANNEL_KEY_SUBSCRIPTION="channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# 단건결제 전용 채널 키
PORTONE_CHANNEL_KEY_ONETIME="channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
PORTONE_API_SECRET="V2_API_SECRET_xxxxxxxxxxxxxxxxxxxxx"
PORTONE_WEBHOOK_SECRET="YOUR_PORTONE_WEBHOOK_SECRET"

# Supabase Configuration (Database & Storage)
# Supabase 대시보드의 Project Settings -> API 에서 확인 가능
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_BUCKET="post-images"

# Naver Social Login
# 네이버 개발자 센터 (https://developers.naver.com/) 에서 앱 등록 후 발급받은 키 입력
NAVER_CLIENT_ID="YOUR_NAVER_CLIENT_ID"
NAVER_CLIENT_SECRET="YOUR_NAVER_CLIENT_SECRET"
NAVER_CALLBACK_URL="http://localhost:3001/api/v1/auth/naver/callback"

# Kakao Social Login
# 카카오 디벨로퍼스 (https://developers.kakao.com/) 에서 앱 등록 후 발급받은 REST API 키 및 시크릿 입력
KAKAO_CLIENT_ID="YOUR_KAKAO_CLIENT_ID"
KAKAO_CLIENT_SECRET="YOUR_KAKAO_CLIENT_SECRET"
KAKAO_CALLBACK_URL="http://localhost:3001/api/v1/auth/kakao/callback"

# Google Social Login
# Google Cloud Console (https://console.cloud.google.com/) 에서 앱 등록 후 발급받은 클라이언트 ID 및 시크릿 입력
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"
